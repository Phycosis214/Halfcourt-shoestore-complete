FROM php:8.3-cli

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev \
    && docker-php-ext-install pdo_pgsql \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html
COPY . .

CMD ["sh", "-c", "php -d session.save_path=/tmp -S 0.0.0.0:${PORT:-80} -t /var/www/html"]